# Replace with a local development database URL. Never commit real credentials.
DATABASE_URL="postgresql://hospital:change-me@localhost:5432/hospital_dev?schema=public"
# PORT=3000
# 프론트와 백엔드가 서로 다른 출처일 때만 경로 없이 설정한다.
# CORS_ORIGIN="http://localhost:5173"
# 아래 키에는 각각 서로 다른 무작위 32바이트를 64자리 16진수로 설정한다.
# RESIDENT_ENCRYPTION_KEY=
# RESIDENT_LOOKUP_KEY=

# --- 인증(로그인·초대·비밀번호 재설정) ---
# 아래 값을 비워 두면 개발 환경에서는 대체 수단으로 동작한다(서버 시작 시 콘솔에 안내가 나온다).
# NODE_ENV=production에서는 SESSION_SECRET, REDIS_URL, APP_BASE_URL, SMTP_HOST, MAIL_FROM이 모두 필요하다.
# 세션 쿠키 서명용 무작위 문자열(32자 이상). 예: openssl rand -hex 32
# SESSION_SECRET=
# 세션과 초대·재설정 링크 저장소. 비우면 메모리에 보관해 서버를 다시 켤 때 사라진다.
# REDIS_URL="redis://localhost:6379"
# 메일의 링크가 가리킬 프론트엔드 주소(경로 없이).
# APP_BASE_URL="http://localhost:5173"
# 메일 발송 서버. SMTP_HOST를 비우면 메일을 보내지 않고 서버 콘솔에 내용을 출력한다.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="no-reply@example.com"
